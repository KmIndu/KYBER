# Application
APP_NAME=Synthetic Data Generator
APP_VERSION=0.1.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Auth
AUTH_ENABLED=true
JWT_SECRET=change-me-in-production-use-a-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15

# SMTP / OTP email settings
# SendGrid SMTP relay
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=kyber.otp@gmail.com
OTP_EXPIRY_SECONDS=300

# Microsoft Graph API (optional alternative to SMTP)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_SENDER_EMAIL=

# AI API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
