{
  "swagger": "2.0",
  "info": {
    "title": "Legacy Insurance API",
    "version": "1.0.0"
  },
  "paths": {},
  "definitions": {
    "Customer": {
      "type": "object",
      "required": ["first_name", "last_name", "email"],
      "properties": {
        "customer_id": {
          "type": "integer",
          "format": "int64"
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "suspended"],
          "default": "active"
        }
      }
    }
  }
}
